# Copy this file to .env and fill in real values.
# .env is gitignored on purpose — never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres connection string Prisma will use.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://cloudcost:cloudcost@localhost:5432/cloudcost_sentinel?schema=public

# Redis connection string.
REDIS_URL=redis://localhost:6379

# JWT secrets — these sign and verify tokens in Phase 3.
# Generate real ones with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
